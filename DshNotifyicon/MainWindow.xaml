<Window x:Class="DshNotifyicon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DSH 托盘助手"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="620" Width="820"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <TabControl x:Name="tabMain" Margin="8">

        <!-- ── 环境 ── -->
        <TabItem x:Name="tabEnv" Header="环境">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnCheck" Content="一键体检" Width="110" Height="30" Click="BtnCheck_Click"/>
                        <TextBlock x:Name="txtCheckStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressBar x:Name="prgOp" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>

                    <GroupBox x:Name="gbPath" Header="PATH 环境变量（Node / pnpm / dsh 检测的前提）" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtPath" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbNode" Header="Node.js 运行环境" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtNode" TextWrapping="Wrap"/>
                            <Button x:Name="btnInstallNode" Content="一键安装 Node.js" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="BtnInstallNode_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbMirror" Header="npm 镜像源（仅对本工具生效，不修改全局配置）" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtRegistry" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox x:Name="cmbMirror" Width="230" SelectionChanged="CmbMirror_SelectionChanged">
                                    <ComboBoxItem Content="默认（跟随 npm 全局配置）"/>
                                    <ComboBoxItem Content="npmmirror（https://registry.npmmirror.com）"/>
                                    <ComboBoxItem Content="自定义…"/>
                                </ComboBox>
                                <TextBox x:Name="txtCustomMirror" Width="230" Margin="8,0,0,0" IsEnabled="False" ToolTip="自定义 registry URL，例如 https://registry.npmjs.org"/>
                                <Button x:Name="btnApplyMirror" Content="应用镜像" Width="90" Margin="8,0,0,0" Click="BtnApplyMirror_Click"/>
                                <Button x:Name="btnGlobalRegistry" Content="写入全局 npmrc…" Width="130" Margin="8,0,0,0" Click="BtnGlobalRegistry_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbDsh" Header="dsh 安装与版本" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtDsh" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="btnInstallDsh" Content="安装 / 更新 dsh" Width="130" Click="BtnInstallDsh_Click"/>
                                <Button x:Name="btnCheckUpdate" Content="检查更新" Width="100" Margin="8,0,0,0" Click="BtnCheckUpdate_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbPnpm" Header="pnpm（dsh 插件管理必需）" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtPnpm" TextWrapping="Wrap"/>
                            <Button x:Name="btnInstallPnpm" Content="一键安装 pnpm" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="BtnInstallPnpm_Click"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ── 服务 ── -->
        <TabItem x:Name="tabService" Header="服务">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="lblPort" Text="端口:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPort" Width="90" Margin="6,0,0,0"/>
                        <CheckBox x:Name="chkRandomPort" Content="随机端口（--port 0）" Margin="12,0,0,0" VerticalAlignment="Center" Checked="ChkRandomPort_Changed" Unchecked="ChkRandomPort_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="lblBind" Text="绑定地址: 127.0.0.1（dsh 仅支持回环地址）" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnStart" Content="启动 DSH" Width="100" Height="30" Click="BtnStart_Click"/>
                    <Button x:Name="btnStop" Content="停止 DSH" Width="100" Height="30" Margin="8,0,0,0" Click="BtnStop_Click"/>
                    <Button x:Name="btnRestart" Content="重启 DSH" Width="100" Height="30" Margin="8,0,0,0" Click="BtnRestart_Click"/>
                    <Button x:Name="btnOpenUi" Content="打开 Web UI" Width="110" Height="30" Margin="8,0,0,0" Click="BtnOpenUi_Click"/>
                </StackPanel>

                <TextBlock x:Name="txtServiceStatus" Grid.Row="2" Margin="0,10,0,0" FontWeight="Bold" TextWrapping="Wrap"/>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="lblLog" Grid.Row="0" Text="运行日志（dsh 输出与操作记录）:" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ── 设置 ── -->
        <TabItem x:Name="tabSettings" Header="设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <CheckBox x:Name="chkAutoOpen" Content="启动 DSH 成功后自动打开浏览器" Margin="0,4,0,0"/>
                    <CheckBox x:Name="chkAutoStart" Content="开机自动启动本工具" Margin="0,10,0,0"/>
                    <CheckBox x:Name="chkShowMain" Content="启动时显示主窗口（默认隐藏到托盘）" Margin="0,10,0,0"/>
                    <CheckBox x:Name="chkAutoStartDsh" Content="托盘启动后自动启动 DSH" Margin="0,10,0,0"/>
                    <TextBlock x:Name="lblExitNote" Text="退出本工具时会自动停止 DSH 服务" Foreground="Gray" Margin="0,10,0,0"/>

                    <GroupBox x:Name="gbLang" Header="界面语言" Margin="0,16,0,0">
                        <StackPanel>
                            <ComboBox x:Name="cmbLang" Width="220" HorizontalAlignment="Left" SelectionChanged="CmbLang_SelectionChanged">
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                            </ComboBox>
                            <TextBlock x:Name="lblLangHint" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbTray" Header="托盘" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="lblDoubleClick" Text="双击托盘图标:"/>
                            <ComboBox x:Name="cmbTrayDoubleClick" Width="220" HorizontalAlignment="Left" SelectionChanged="CmbTrayDoubleClick_Changed">
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                            </ComboBox>
                            <TextBlock x:Name="lblDoubleClickHint" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbAdvanced" Header="高级" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="lblTrusted" Text="trusted-host（可选，逗号/分号分隔，可重复传给 dsh）:"/>
                            <TextBox x:Name="txtTrustedHosts" Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblNodePath" Text="Node.js 可执行文件路径（留空自动检测）:" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtNodePath" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbCleanup" Header="清理" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="lblCleanupDesc" TextWrapping="Wrap" Foreground="Gray"
                                       Text="移除 dsh 相关环境：停止 dsh 服务 → 卸载全局 npm 包 @deepseek-ai/dsh → 将数据目录（含 API 凭据与会话）重命名备份为 .dsh.bak-日期（不直接删除）。不会卸载 Node.js；如确需卸载 Node.js，请到系统 设置→应用 或执行 winget uninstall OpenJS.NodeJS.LTS。"/>
                            <Button x:Name="btnCleanup" Content="清理 dsh 环境…" Width="140" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnCleanup_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="btnSaveSettings" Content="保存设置" Width="100" Height="30" Click="BtnSaveSettings_Click"/>
                        <Button x:Name="btnOpenSettingsDir" Content="打开配置目录" Width="120" Height="30" Margin="8,0,0,0" Click="BtnOpenSettingsDir_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ── 通知增强 ── -->
        <TabItem x:Name="tabNotify" Header="通知增强">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <CheckBox x:Name="chkNotifyEnable" Content="启用通知增强" Margin="0,4,0,0"/>
                    <CheckBox x:Name="chkNotifySubagents" Content="子代理/子任务完成时也通知" Margin="0,10,0,0"/>
                    <CheckBox x:Name="chkNotifyTray" Content="显示托盘通知" Margin="0,10,0,0"/>

                    <GroupBox x:Name="gbExternalHook" Header="外部命令" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox x:Name="chkNotifyExternal" Content="启用外部命令" Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblHookCommand" Text="命令:" Margin="0,8,0,0"/>
                            <TextBox x:Name="txtHookCommand" Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblHookArgs" Text="参数模板:" Margin="0,8,0,0"/>
                            <TextBox x:Name="txtHookArgs" Margin="0,4,0,0" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                            <TextBlock x:Name="lblHookHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="支持占位符: {event} {title} {sessionId} {parentSessionId} {turn} {reason} {durationMs}"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="btnInstallNotifyPlugin" Content="安装/更新 dsh 通知插件" Width="190" Height="30" Click="BtnInstallNotifyPlugin_Click"/>
                        <Button x:Name="btnUninstallNotifyPlugin" Content="卸载 dsh 通知插件" Width="130" Height="30" Margin="8,0,0,0" Click="BtnUninstallNotifyPlugin_Click"/>
                        <Button x:Name="btnTestNotify" Content="测试通知" Width="100" Height="30" Margin="8,0,0,0" Click="BtnTestNotify_Click"/>
                        <Button x:Name="btnSaveNotify" Content="保存设置" Width="100" Height="30" Margin="8,0,0,0" Click="BtnSaveNotify_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ── 关于 ── -->
        <TabItem x:Name="tabAbout" Header="关于">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="560">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/app.ico" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtAboutName" Text="DSH 托盘助手" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="txtAboutVersion" Foreground="Gray" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="txtAboutDesc" TextWrapping="Wrap" Margin="0,16,0,0"
                               Text="DeepSeek Harness（dsh）的桌面托盘助手：一键完成环境配置（Node.js / npm 镜像源 / dsh 安装与更新）与 Web UI 启停，自动解析实际地址并打开浏览器——无需手动打开命令行窗口。"/>

                    <GroupBox x:Name="gbTech" Header="技术栈" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtTech1" Text="· WPF · .NET Framework 4.6.2 · C# 7.3"/>
                            <TextBlock x:Name="txtTech2" Text="· Hardcodet.NotifyIcon.Wpf（托盘）· Newtonsoft.Json（设置）" Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtTech3" Text="· 服务对象：DeepSeek Harness CLI（dsh）" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbLinks" Header="链接" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run x:Name="runLinkDh" Text="DeepSeek Harness: "/>
                                <Hyperlink NavigateUri="https://github.com/deepseek-ai/deepseek-harness" RequestNavigate="Hyperlink_RequestNavigate">github.com/deepseek-ai/deepseek-harness</Hyperlink>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run x:Name="runLinkRepo" Text="本工具仓库: "/>
                                <Hyperlink NavigateUri="https://github.com/Hope-Phenom/dsh-desktop-tray" RequestNavigate="Hyperlink_RequestNavigate">github.com/Hope-Phenom/dsh-desktop-tray</Hyperlink>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run x:Name="runLinkSite" Text="在线页面: "/>
                                <Hyperlink NavigateUri="https://hope-phenom.github.io/dsh-desktop-tray/" RequestNavigate="Hyperlink_RequestNavigate">hope-phenom.github.io/dsh-desktop-tray</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="gbLicense" Header="版权与致谢" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtLicense" TextWrapping="Wrap" Text="License: MIT（见仓库 LICENSE.txt）"/>
                            <TextBlock x:Name="txtCredits" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="图标基于 DeepSeek 官方 favicon 渲染；感谢 DeepSeek Harness 团队以及 Hardcodet.NotifyIcon.Wpf、Newtonsoft.Json 开源项目。"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
